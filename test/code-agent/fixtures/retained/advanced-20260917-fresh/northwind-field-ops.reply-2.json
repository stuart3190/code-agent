    "projectType": "dashboard",
    "journeys": [
      {
        "id": "create-work-order",
        "title": "A dispatcher signs in and creates a work order",
        "priority": "primary",
        "stage": "primary_journey",
        "steps": [
          {
            "action": "open the sign-in page",
            "target": "/signin",
            "expect": "email and password controls are visible"
          },
          {
            "action": "sign in as a dispatcher",
            "target": "sign-in form",
            "operates": [
              "authEmail",
              "authPassword",
              "sign-in-dispatcher"
            ],
            "expect": "the work orders navigation and dispatcher workspace are visible"
          },
          {
            "action": "open the work orders page",
            "target": "/work-orders",
            "expect": "the work order list and create work order control are visible"
          },
          {
            "action": "create a work order with a title, site, priority, scheduled date, assigned technician and status",
            "target": "create work order form",
            "operates": [
              "title",
              "siteId",
              "priority",
              "scheduledDate",
              "assignedTechnicianId",
              "status",
              "create-work-order"
            ],
            "reads": [
              "id"
            ],
            "expect": "the new work order appears in the list with its title, site, priority, scheduled date, assigned technician and status"
          },
          {
            "action": "open the created work order detail route",
            "target": "/work-orders/:workOrderId",
            "reads": [
              "id",
              "title"
            ],
            "expect": "the detail page shows the work order title, site, assigned technician, status and visit log section"
          },
          {
            "action": "reload",
            "reads": [
              "id",
              "title",
              "status"
            ],
            "expect": "the same work order detail page still shows the saved work order after reload"
          }
        ],
        "acceptance": [
          "a dispatcher-created work order is visible in the list",
          "the created work order has its own detail route",
          "the created work order remains visible after a full page reload"
