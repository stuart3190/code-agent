# shell/.env example — copy to shell/.env (gitignored) and fill in real values.
# Only the preview vars are documented here; Supabase + Stripe keys are also required
# (see baseline/PHASE-5-SHELL.md for the full list).

# Preview backing: local (real Vite on this box) | vps (real provisiond) | vps-stub (no-op)
PREVIEW_MODE=vps

# Local end of the SSH tunnel to provisiond (which binds VPS 127.0.0.1:8790):
#   ssh -N -L 18790:127.0.0.1:8790 ubuntu@<vps>
PROVISIOND_URL=http://127.0.0.1:18790

# provisiond bearer identity token — must match the VPS ~/provisiond/.env value.
PROVISIOND_TOKEN=__provisiond_token__

# Public wildcard suffix previews are served under. Documentation only: provisiond returns
# fully-qualified https://<label>.preview.buildr101.com/ URLs, so the shell doesn't consume this.
PREVIEW_PUBLIC_SUFFIX=preview.buildr101.com

# Stock images (optional): Pexels API key (free — pexels.com/api). When set, the engine gains a
# search_images tool and embeds real contextual photos in site-style builds. Absent = no images.
PEXELS_API_KEY=

# BYOK — server-side encryption key for users' stored API keys (AES-256-GCM at rest). 32 bytes as
# 64 hex chars (generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
# Required only for BYOK save/use; keep it secret and stable (rotating it strands existing stored keys).
BYOK_ENC_KEY=__64_hex_chars__
# Optional generated-app SMS delivery (email uses RESEND_API_KEY / RESEND_FROM).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Google Workspace connectors. Create one OAuth 2.0 Web application and register:
#   https://buildr101.com/api/connectors/oauth/google/callback
# Keep both values server-side. Without them the Google cards remain visible but disabled.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
