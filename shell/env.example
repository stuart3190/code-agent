# shell/.env example — copy to shell/.env (gitignored) and fill in real values.
# Only the preview vars are documented here; Supabase + Stripe keys are also required
# (see baseline/PHASE-5-SHELL.md for the full list).

# Preview backing: local (real Vite on this box) | vps (real provisiond) | vps-stub (no-op)
PREVIEW_MODE=vps

# Local end of the SSH tunnel to provisiond (which binds VPS 127.0.0.1:8790):
#   ssh -N -L 18790:127.0.0.1:8790 ubuntu@<vps>
PROVISIOND_URL=http://127.0.0.1:18790

# provisiond bearer identity token — must match the VPS ~/provisiond/.env value.
PROVISIOND_TOKEN=__provisiond_token__

# Public wildcard suffix previews are served under. Documentation only: provisiond returns
# fully-qualified https://<label>.preview.buildr101.com/ URLs, so the shell doesn't consume this.
PREVIEW_PUBLIC_SUFFIX=preview.buildr101.com
