# Non-secret production proof anchors. Install as /etc/thrallo/dr-health.env mode 0644.
THRALLO_LAST_RESTORE_EVIDENCE=/home/ubuntu/thrallo-restore-evidence/<latest>/evidence.sha256
THRALLO_EXPECTED_DEPLOYMENT_SHA=<deployment-manifest-sha256>
# Optional secret webhook belongs in the operator secret store, not this example.
# THRALLO_OPS_ALERT_WEBHOOK=https://...
