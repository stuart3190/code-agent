[Unit]
Description=Encrypt and copy the latest Thrallo backup off-host
After=network-online.target thrallo-backup.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/code-agent
EnvironmentFile=/etc/thrallo/offsite-backup.env
ExecStart=/usr/bin/node /home/ubuntu/code-agent/ops/offsite-backup.mjs --upload
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubuntu/thrallo-backups
UMask=0077
