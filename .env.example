# Thrallo server. Copy to shell/.env for local work. Never commit real values.
SHELL_PORT=8787
APP_URL=http://localhost:5173
CODE_AGENT_STANDALONE=on

# Dedicated Thrallo Supabase project. Do not point this at Buildr101 production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CODE_AGENT_STORE=memory
PLATFORM_ENC_KEY=

# Commercial model provider and isolated runner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
CODE_AGENT_EMBEDDING_MODEL=text-embedding-3-small
CODE_AGENT_INDEX_MAX_FILES=600
CODE_AGENT_INDEX_MAX_BYTES=10000000
CODE_AGENT_INDEX_MAX_FILE_BYTES=350000
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
CODE_AGENT_DEFAULT_PROVIDER=openai
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_TARGET=eu

# Temporary v1 bridge for private clones. Replace with GitHub App installation tokens.
GITHUB_AGENT_TOKEN=

# Preferred GitHub App flow. Store the PEM as a multiline value or with literal \n characters.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_STATE_SECRET=
GITHUB_WEBHOOK_SECRET=

CODE_AGENT_WORKER=on
CODE_AGENT_POLL_MS=1500
CODE_AGENT_INDEX_POLL_MS=2500
CODE_AGENT_STALE_RUN_MINUTES=15
DAYTONA_AUTO_STOP_MINUTES=30
DAYTONA_AUTO_ARCHIVE_MINUTES=120
DAYTONA_AUTO_DELETE_MINUTES=1440
