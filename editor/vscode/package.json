{
  "name": "thrallo",
  "displayName": "Thrallo — Cloud Coding Agents",
  "description": "Launch Thrallo cloud coding agents on your repositories: stream live run timelines, review diffs, approve pull requests, and resume preserved workspaces — without leaving VS Code.",
  "version": "0.3.0",
  "publisher": "thrallo",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b0d12",
    "theme": "dark"
  },
  "keywords": [
    "ai",
    "agent",
    "code review",
    "automation",
    "cloud"
  ],
  "homepage": "https://app.thrallo.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/stuart3190/code-agent"
  },
  "bugs": {
    "url": "https://github.com/stuart3190/code-agent/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thrallo",
          "title": "Thrallo",
          "icon": "media/thrallo.svg"
        }
      ]
    },
    "views": {
      "thrallo": [
        {
          "id": "thralloAgents",
          "name": "Agents"
        }
      ]
    },
    "commands": [
      { "command": "thrallo.connect", "title": "Thrallo: Connect" },
      { "command": "thrallo.disconnect", "title": "Thrallo: Disconnect" },
      { "command": "thrallo.refresh", "title": "Thrallo: Refresh Agents", "icon": "$(refresh)" },
      { "command": "thrallo.runTask", "title": "Thrallo: Run Agent Task" },
      { "command": "thrallo.showLatestRun", "title": "Thrallo: Show Latest Run" },
      { "command": "thrallo.openConversation", "title": "Thrallo: Open Conversation" }
    ],
    "walkthroughs": [
      {
        "id": "thrallo.welcome",
        "title": "Get started with Thrallo",
        "description": "Connect your account and put cloud coding agents to work.",
        "steps": [
          {
            "id": "thrallo.welcome.connect",
            "title": "Connect to Thrallo",
            "description": "Create an API token in the Thrallo web workspace (Settings → API tokens), then connect.\n[Connect](command:thrallo.connect)",
            "media": { "markdown": "media/walkthrough/connect.md" },
            "completionEvents": ["onCommand:thrallo.connect"]
          },
          {
            "id": "thrallo.welcome.run",
            "title": "Run your first agent task",
            "description": "Pick an agent in the Thrallo view and describe a change. The run streams live into the Thrallo output channel.\n[Run a task](command:thrallo.runTask)",
            "media": { "markdown": "media/walkthrough/run.md" },
            "completionEvents": ["onCommand:thrallo.runTask"]
          },
          {
            "id": "thrallo.welcome.completions",
            "title": "Enable inline completions",
            "description": "Completions use your Thrallo allowance, so they are opt-in.\n[Open settings](command:workbench.action.openSettings?%22thrallo.completions%22)",
            "media": { "markdown": "media/walkthrough/completions.md" },
            "completionEvents": ["onSettingChanged:thrallo.completions.enabled"]
          }
        ]
      }
    ],
    "menus": {
      "view/title": [
        { "command": "thrallo.refresh", "when": "view == thralloAgents", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "thrallo.runTask", "when": "view == thralloAgents && viewItem == agent" },
        { "command": "thrallo.showLatestRun", "when": "view == thralloAgents && viewItem == agent" }
      ]
    },
    "configuration": {
      "title": "Thrallo",
      "properties": {
        "thrallo.serverUrl": {
          "type": "string",
          "default": "https://app.thrallo.com",
          "description": "Thrallo control-plane origin."
        },
        "thrallo.completions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable inline code completions from Thrallo. Completions use your Thrallo model allowance (or BYOK key), so this is opt-in."
        },
        "thrallo.completions.repository": {
          "type": "string",
          "default": "",
          "description": "Connected repository (owner/name) whose Thrallo index provides completion context. Auto-detected when exactly one repository is connected."
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package"
  }
}
