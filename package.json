{
  "name": "code-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Thrallo control plane and cloud coding-agent runtime.",
  "bin": {
    "thrallo": "cli/thrallo.mjs"
  },
  "scripts": {
    "harness": "node harness/run.mjs",
    "baseline": "node harness/run.mjs --baseline",
    "test:billing": "node harness/_billing-tests.mjs",
    "test:ledger": "node harness/_ledger-tests.mjs",
    "test:export": "node shell/harness/_export-tests.mjs",
    "test:static-security": "node shell/harness/_static-path-tests.mjs",
    "test:http-security": "node shell/harness/_http-security-tests.mjs",
    "test:backup-validation": "node harness/_backup-validation-tests.mjs",
    "test:draft-project": "node harness/_draft-project-tests.mjs",
    "test:ownership": "node shell/harness/_ownership-tests.mjs",
    "test:billing-limits": "node harness/_billing-limit-tests.mjs",
    "test:instagram-publishing": "node harness/_instagram-publishing-tests.mjs",
    "test:foundations": "node harness/_foundation-tests.mjs",
    "test:qa-runner": "node harness/_qa-runner-tests.mjs",
    "test:saas-payments": "node harness/_saas-payments-tests.mjs",
    "test:visual-brand": "node harness/_visual-brand-tests.mjs",
    "repair:visual-brands": "node scripts/reapply-visual-brands.mjs",
    "test:owner-console": "node harness/_owner-console-tests.mjs",
    "test:github-sync": "node harness/_github-sync-tests.mjs",
    "test:app-integrations": "node harness/_app-integrations-tests.mjs",
    "test:connectors": "node harness/_connector-hub-tests.mjs",
    "test:capability-runtime": "node harness/_capability-runtime-tests.mjs",
    "test:analytics": "node harness/_analytics-tests.mjs",
    "test:environments": "node harness/_environment-tests.mjs",
    "test:templates": "node harness/_template-tests.mjs",
    "test:e2e": "npm --prefix shell/web run build && playwright test",
    "backup:validate": "node scripts/validate-backup.mjs",
    "test:design": "node harness/_design-profile-tests.mjs",
    "prove:billing": "node harness/proveBilling.mjs",
    "prove:jobs": "node shell/harness/prove-jobs.mjs",
    "test:code-agent": "node --test test/code-agent/*.test.mjs",
    "test:desktop:d0": "node --test test/desktop/d0-contracts.test.mjs && node desktop/d0/guard.mjs",
    "test:desktop:d1": "node --test test/desktop/d1-client.test.mjs && node desktop/d0/guard.mjs",
    "test:desktop:d2": "node --test test/desktop/d2-auth.test.mjs && node desktop/auth/smoke.mjs && node desktop/d0/guard.mjs",
    "test:desktop:d3": "node --test test/desktop/d3-access.test.mjs && node desktop/account/smoke.mjs && node desktop/d0/guard.mjs",
    "test:desktop:d4": "node --test test/desktop/d4-spike.test.mjs && node desktop/d0/guard.mjs",
    "spike:desktop:d4": "node desktop/d4/live/run.mjs --confirm-synthetic",
    "smoke:desktop:auth": "node desktop/auth/smoke.mjs",
    "smoke:desktop:account": "node desktop/account/smoke.mjs",
    "test:bv2:qualification": "node ops/run-bv2-qualification.mjs",
    "test:ui": "playwright test e2e/public-shell.spec.mjs e2e/chat-shell.spec.mjs e2e/theme-check.spec.mjs e2e/provider-settings.spec.mjs",
    "audit:remediation-baseline": "node ops/capture-remediation-baseline.mjs",
    "supabase:version": "supabase --version",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local --no-seed",
    "supabase:lint": "supabase db lint --local --schema public --level error --fail-on error",
    "supabase:diff": "supabase db diff --local --schema public",
    "supabase:migrations": "supabase migration list --local",
    "supabase:history:verify": "node ops/validate-migration-history.mjs",
    "supabase:edge:check": "npx --yes deno@2.5.1 check supabase/functions/app-auth/index.ts",
    "supabase:graph:proof": "node ops/prove-bv2-graph-postgres.mjs",
    "supabase:worker:proof": "node ops/prove-build-worker-postgres.mjs",
    "supabase:runtime:proof": "node ops/prove-bv2-runtime-postgres.mjs",
    "worker:ops": "node ops/build-worker.mjs",
    "worker:start": "node build-worker/index.mjs",
    "worker:sandbox:build": "docker build -t thrallo-build-sandbox:latest -f build-worker/Dockerfile .",
    "worker:sandbox:proof": "node ops/prove-build-worker-sandbox.mjs",
    "worker:e2e:proof": "node ops/prove-build-worker-e2e.mjs",
    "publish:ops": "node ops/publish-releases.mjs",
    "publish:db:proof": "node ops/prove-atomic-publishing-postgres.mjs",
    "security:secrets": "node ops/scan-secrets.mjs",
    "release:verify": "node ops/verify-release-artifacts.mjs",
    "build:web": "npm --prefix shell/web run build",
    "verify": "npm run build:web && npm run test:code-agent && npm run test:ui"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@daytona/sdk": "0.201.0",
    "@openai/codex": "0.146.0",
    "@supabase/supabase-js": "2.111.0",
    "sharp": "0.35.3",
    "stripe": "17.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "supabase": "2.111.0"
  }
}
